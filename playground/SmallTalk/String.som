String = (
      + obj = ( ^ self concatWith: obj asString  )
      concatWith: otherString = primitive
      asString = ( ^ self )
      asSymbol = primitive
      substringFrom: from to: to = ( ^ self primSubstringFrom: from to: to. )
      primSubstringFrom: _ to: _ = primitive

      "Printing"
      print = ( system printString: self )
)
