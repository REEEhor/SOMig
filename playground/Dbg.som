Dbg = (
    run = (
        self loop: 5.
    )
    
    loop: x = (
        | blk |
        blk := [
            x == 0
                ifTrue:  [ ^nil ]
                ifFalse: [ 
                    ('x=' + x) println.
                    "x := x - 1."
                    blk value.
                ]
        ].
        blk value. 
    )
)
