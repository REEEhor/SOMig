Animal = (
    | name |

    name = ( ^ name )

    asString = ( ^ 'animal named "' + (self name) + '"' )

    set_name_to: new_name = (
       name := new_name.
    )

    say_hi = (
      'The animal "' print.
      name print.
      '" says "hi!"' println.
    )

    " Used for super call shinenigans "
    get_likability = ( ^ 5. )

    print_likability = (
       ('The likability is: ' + self get_likability + '/10') println.
    )

  ------------------------------------------------------
    static_say_hi = (
        'Static "Hi!" from the Animal class' println.
    )
)
