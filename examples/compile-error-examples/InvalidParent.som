" Run this class with no arguments to see the help message. "

" Loads the class in helper_classes_for_errors/ClassWithInvalidParent.som "
" But before, it sets its parent class (called 'Parent') to some non-class object. "
InvalidParent = (
    run: args = (
        |arg|
        (
           ' This demo sets a parent of class to a non-class object\n' +
           ' and then tries to load the child class.\n' +
           ' You specify what the non-class object will be.\n'
        ) println.
        
        (args length ~= 2)
            ifTrue: [
                '\x1b[31mERROR: This demo expects a single argument.\x1b[0m\nUsage: InvalidParent \x1b[32mint\x1b[0m or \x1b[32mstr\x1b[0m or \x1b[32mnil\x1b[0m or \x1b[32mkitty\x1b[0m' println.
                self exit: 1.
            ].
        
        arg := args at: 2.
        
        ('Okay, setting the global named "Parent" to an instance of ' + arg + '.') println.
        Parent := 'unspecified'.
        arg = 'int'
            ifTrue: [ Parent := 42. ]. 
        arg = 'str'
            ifTrue: [ Parent := 'some string'. ]. 
        arg = 'nil'
            ifTrue: [ Parent := nil. ]. 
        arg = 'kitty'
            ifTrue: [
                |kitty|
                kitty := Kitty new.
                Parent := kitty.
            ]. 
       
        Parent = 'unspecified' 
            ifTrue: [
                ('\x1b[31mERROR:\x1b[0m Invalid argument \'\x1b[31m' + arg + '\x1b[0m\'. Expected one of \x1b[32mint\x1b[0m or \x1b[32mstr\x1b[0m or \x1b[32mnil\x1b[0m or \x1b[32mkitty\x1b[0m.') println.
                self exit: 2.
            ].
        
        'Done! Now we load the class "ClassWithInvalidParent"! Expect a runtime error...'  println.
            
        "Now we load the class"
        ClassWithInvalidParent.
    )
)
