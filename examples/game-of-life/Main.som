Main = (
    | states state_idx |

    run = (
        state_idx := 1.
        states := #(
            (Array2d width: 10 height: 10)
            (Array2d width: 10 height: 10)
        ).

        (states at: 1) at: (Vec2 x: 4 y: 1) put: 1.
        (states at: 1) at: (Vec2 x: 4 y: 2) put: 1.
        (states at: 1) at: (Vec2 x: 4 y: 3) put: 1.
        (states at: 1) at: (Vec2 x: 3 y: 3) put: 1.
        (states at: 1) at: (Vec2 x: 2 y: 2) put: 1.

        Ansi clear_screen.
        
        [true] whileTrue: [
            self write_to_next_state.
            self render_and_swap_buffers.
            self sleep_for: 200.
        ]
    )

    write_to_next_state = (
        | s s_next | 
        s := self current_state.
        s_next := self next_state.

        s iter_positions: [ :pos | 
            | n is_alive | 
            is_alive := (s at: pos) = 1.

            " Count neighbours " 
            n := 0.
            -1 to: 1 do: [ :y_offset | 
                -1 to: 1 do: [ :x_offset |
                    | new_pos |
                    new_pos := Vec2 x: (pos x + x_offset) y: (pos y + y_offset).
                    (s contains: new_pos) ifTrue:  [ n := n + (s at: new_pos) ]. 
                ].
            ].
            n := n - (s at: pos). " subtract the current cell "

            "pos x print. ' ' print. pos y print. ': ' print. ' ' print. is_alive print. '  n=' print. n println."
            
            ((n = 3) || (is_alive && (n = 2))) 
                ifTrue:  [s_next at: pos put: 1]
                ifFalse: [s_next at: pos put: 0].
        ].
    )

    render_and_swap_buffers = (
        | width height | 
        width := self current_state get_width. 
        height := self current_state get_height. 
         
        Ansi hide_cursor.
        Ansi cursor_to_origin.
        
        1 to: width + 2 do: [ :_ | (Ansi bg_white + '  ') print ].
        Ansi reset println.
         
        self current_state iter_positions: [ :pos |
                (pos x = 1) ifTrue: [ (Ansi bg_white + '  ') print ].
                
                ((self current_state at: pos) = 1)
                    ifTrue:  [ (Ansi bg_blue + '  ') print] 
                    ifFalse: [ (Ansi reset   + '  ') print].
                    
                (pos x = width) ifTrue: [ (Ansi bg_white + '  ') print. Ansi reset println. ].
        ].
        
        1 to: width + 2 do: [ :_ | (Ansi bg_white + '  ') print ].
       
        Ansi reset print. 
        Ansi show_cursor.
            
        state_idx := self opposite_state_idx.
    )

    opposite_state_idx = (
        ^ 3 - state_idx.
    )

    current_state = (
        ^ states at: state_idx
    )
    
    next_state = (
        ^ states at: self opposite_state_idx 
    )

    sleep_for: millis = (
        | end_time |
        end_time := system ticks + (millis * 1000).
        [system ticks < end_time] whileTrue: [].
    )
)
