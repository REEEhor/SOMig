Example = (
	someMethod: arg1 withArg: arg2 = ( arg1 println. arg2 println )
	someMethod: arg1 withArg: arg2 andAnotherArg: arg3 = ( arg1 println. arg2 println. arg3 println. )

	apply: arrayOfArguments = (
		| arr |
		arr := arrayOfArguments.

		(arr length == 2)
			ifTrue:  [ ^self someMethod: (arr at: 1) withArg (arr at: 2) ]
			ifFalse: [
				(arr length == 3)
					ifTrue:  [ ^self someMethod: (arr at: 1) withArg: (arr at: 2) andAnotherArg: (arr at: 3) ]
					ifFalse: [ self error: 'Array has length of ' + (arr length) + ', but valid length is either 2 or 3.' ]
				value " <- maybe? "
			]
	)
)
