NamespaceLikeClass = (
	----

	| global_1 global_2 |

	get1 = ( ^ global_1 + 1 - 1. )
	get2 = ( ^ global_2 )

	set1: newValue = ( global_1 := newValue )
	set2: newValue = ( global_2 := newValue.
	)
	" Wierd use of the syntax on the method `set2` to validate parsing :D "

	getProduct = ( ^ global_1 * global_2 )
)
